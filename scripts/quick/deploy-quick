#!/usr/bin/env bash

set -euo pipefail

confirmed=false
case "${1:-}" in
  --confirm) confirmed=true ;;
  -h|--help)
    echo "Usage: $0 [--confirm]"
    echo "Deploy the Quick preview; --confirm skips interactive approval."
    exit 0
    ;;
  '') ;;
  *) echo "Usage: $0 [--confirm]" >&2; exit 2 ;;
esac
if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [--confirm]" >&2
  exit 2
fi

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."
deployment_url=$(quick url)
if [[ "$confirmed" != true ]]; then
  if [[ ! -t 0 ]]; then
    echo "Deployment requires interactive approval; pass --confirm to approve explicitly." >&2
    exit 1
  fi
  read -r -p "Deploy this checkout to ${deployment_url}? [y/N] " answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) echo "Deployment cancelled."; exit 0 ;;
  esac
fi

quick deploy .
