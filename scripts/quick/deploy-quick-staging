#!/usr/bin/env bash

set -euo pipefail

confirmed=false
case "${1:-}" in
  --confirm) confirmed=true ;;
  -h|--help)
    echo "Usage: $0 [--confirm]"
    echo "Deploy the Quick preview; --confirm skips interactive approval."
    exit 0
    ;;
  '') ;;
  *) echo "Usage: $0 [--confirm]" >&2; exit 2 ;;
esac
if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [--confirm]" >&2
  exit 2
fi

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."

production_url=$(quick url)
production_host=${production_url#*://}
production_host=${production_host%%/*}

case "$production_host" in
  *.quick.mozilla.cloud)
    production_name=${production_host%.quick.mozilla.cloud}
    ;;
  *)
    echo "Could not derive a site name from Quick URL: $production_url" >&2
    exit 1
    ;;
esac

staging_name="${production_name}-staging"
if [[ ${#staging_name} -gt 63 ]]; then
  echo "Derived staging site name is longer than Quick's 63-character limit: $staging_name" >&2
  exit 1
fi

deployment_url="https://${staging_name}.quick.mozilla.cloud/"
if [[ "$confirmed" != true ]]; then
  if [[ ! -t 0 ]]; then
    echo "Deployment requires interactive approval; pass --confirm to approve explicitly." >&2
    exit 1
  fi
  read -r -p "Deploy this checkout to ${deployment_url}? [y/N] " answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) echo "Deployment cancelled."; exit 0 ;;
  esac
fi

echo "Deploying staging site: https://${staging_name}.quick.mozilla.cloud/"
quick deploy . "$staging_name"
